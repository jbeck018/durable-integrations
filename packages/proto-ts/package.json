{
  "name": "@flowforge/proto-ts",
  "version": "0.1.0",
  "description": "Auto-generated TypeScript types, Connect client stubs, and TanStack Query hooks from FlowForge proto definitions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schemas": {
      "import": "./dist/schemas/index.js",
      "types": "./dist/schemas/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "generate": "buf generate --template ../../buf.gen.yaml",
    "clean": "rm -rf dist src/gen"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.0.0",
    "@connectrpc/connect": "^2.0.0",
    "@connectrpc/connect-web": "^2.0.0",
    "@connectrpc/connect-query": "^2.0.0",
    "@tanstack/react-query": "^5.0.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.0.0",
    "@connectrpc/protoc-gen-connect-query": "^2.0.0",
    "typescript": "^5.6.3"
  },
  "files": [
    "dist",
    "src/gen"
  ]
}
